{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lathosworld",
  // Delegates to the TanStack Start server entry after one canonical 301.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  // Required by `wrangler preview` (Workers Builds branch previews). Empty is fine.
  "previews": {}
}
