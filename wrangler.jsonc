{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lathosworld",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  // Full WAVs are too large for Workers static assets. Objects live in this
  // bucket and are streamed from /music/<key>. See README, Music.
  "r2_buckets": [
    {
      "binding": "MUSIC",
      "bucket_name": "lathosworld-music"
    }
  ],
  // Required by `wrangler preview` (Workers Builds branch previews). Empty is fine.
  "previews": {}
}
