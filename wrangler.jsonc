{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lathosworld",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true,
  },
  // Song masters are not served by the Worker. Previews are static files
  // in public/previews. The private R2 bucket is no longer bound.
  // Required by `wrangler preview` (Workers Builds branch previews). Empty is fine.
  "previews": {},
}
